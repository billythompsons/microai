import {db,json,owner,safeUrl,slug} from './_shared.mts';import {chunkText,localEmbedding,vectorLiteral} from '../../packages/core/src/embedding.ts';import {gunzipSync,inflateRawSync} from 'node:zlib';
const clean=(html:string)=>html.replace(/<script[\s\S]*?<\/script>|<style[\s\S]*?<\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/\s+/g,' ').trim();
const unzipText=(bytes:Uint8Array)=>{let at=0,out='';while(at+30<bytes.length){if(bytes[at]!==0x50||bytes[at+1]!==0x4b||bytes[at+2]!==3||bytes[at+3]!==4)break;const view=new DataView(bytes.buffer,bytes.byteOffset+at),method=view.getUint16(8,true),size=view.getUint32(18,true),nameLen=view.getUint16(26,true),extraLen=view.getUint16(28,true),name=new TextDecoder().decode(bytes.slice(at+30,at+30+nameLen)),start=at+30+nameLen+extraLen,data=bytes.slice(start,start+size);if(/\.(xml|txt)$/i.test(name)){try{const raw=method===0?data:method===8?inflateRawSync(data):null;if(raw)out+=' '+clean(new TextDecoder().decode(raw))}catch{}}at=start+size}return out.trim()};
const fileText=(bytes:Uint8Array,mime:string,name:string)=>{if(bytes.length>200000)throw Error('File is larger than 200 KB');if(/\.pdf$/i.test(name)||mime==='application/pdf')throw Error('PDF parsing is not available yet. Paste its text or use a public URL.');if(/\.(docx|odt)$/i.test(name)||/officedocument|opendocument/.test(mime)){const text=unzipText(bytes);if(!text)throw Error('No readable text was found in this document');return text}if(!/^(text\/|application\/(json|xml))/.test(mime)&&!(/\.(txt|md|csv|json|html?|xml)$/i.test(name)))throw Error('Use TXT, Markdown, CSV, JSON, HTML, XML, DOCX, or ODT');return clean(new TextDecoder().decode(bytes))};
export default async(req:Request)=>{if(req.method!=='POST')return json({error:'Method not allowed'},405);const own=owner(req);if(!own)return json({error:'Valid anonymous session required'},401);const sql=db();let b:any={},fileName='',fileMime='',fileBytes:Uint8Array|null=null;const type=req.headers.get('content-type')||'';if(type.includes('multipart/form-data')){const form=await req.formData(),f=form.get('file');b={publicId:form.get('publicId'),kind:'file',title:form.get('title')};if(!(f instanceof File))return json({error:'Choose a file'},400);fileName=f.name.slice(0,120);fileMime=f.type;fileBytes=new Uint8Array(await f.arrayBuffer())}else b=await req.json().catch(()=>({}));const agent=String(b.publicId||''),kind=String(b.kind||'text');const found=await sql`select public_id from public_agents where public_id=${agent} and owner_hash=${own}`;if(!found[0])return json({error:'Bot not found'},404);const count=await sql`select count(*)::int n from public_sources where agent_public_id=${agent}`;if(+count[0].n>=20)return json({error:'Source limit reached (20 per bot)'},429);let content='',url='',title=String(b.title||'').trim().slice(0,120);if(kind==='url'){try{const u=await safeUrl(String(b.url||''));url=u.toString();const r=await fetch(u,{redirect:'manual',headers:{'user-agent':'AIChatroom/1.0 source fetcher'}});if(r.status>=300&&r.status<400)throw Error('Redirects are blocked; use the final public URL');if(!r.ok)throw Error(`URL returned ${r.status}`);const len=+(r.headers.get('content-length')||0);if(len>200000)throw Error('URL is larger than 200 KB');content=clean((await r.text()).slice(0,200000)).slice(0,60000);title=title||u.hostname}catch(e){return json({error:(e as Error).message},400)}}else if(kind==='file'&&fileBytes){try{content=fileText(fileBytes,fileMime,fileName).slice(0,60000);url=`aichatroom://file/${slug()}`;title=title||fileName}catch(e){return json({error:(e as Error).message},400)}}else{content=String(b.content||'').trim().slice(0,60000);url=`aichatroom://text/${slug()}`;title=title||'Pasted text'}if(content.length<20)return json({error:'Source must contain at least 20 characters'},400);const source=await sql`insert into public_sources(agent_public_id,kind,title,source_url,content_chars) values(${agent},${kind},${title},${url},${content.length}) returning id`;const sourceSlug=source[0].id,chunks=chunkText(content).slice(0,40);for(let i=0;i<chunks.length;i++){const v=vectorLiteral(localEmbedding(chunks[i]));await sql`insert into knowledge_chunks(agent_public_id,source_slug,source_title,source_url,chunk_index,content,embedding) values(${agent},${sourceSlug},${title},${url},${i},${chunks[i]},${v}::vector)`}return json({source:{id:sourceSlug,kind,title,url,chunks:chunks.length,contentChars:content.length}},201)}
