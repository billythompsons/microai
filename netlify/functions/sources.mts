import {db,json,owner,safeUrl,slug} from './_shared.mts';import {chunkText,localEmbedding,vectorLiteral} from '../../packages/core/src/embedding.ts';
const clean=(html:string)=>html.replace(/<script[\s\S]*?<\/script>|<style[\s\S]*?<\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/\s+/g,' ').trim();
export default async(req:Request)=>{if(req.method!=='POST')return json({error:'Method not allowed'},405);const own=owner(req);if(!own)return json({error:'Valid anonymous session required'},401);const sql=db(),b=await req.json().catch(()=>({})),agent=String(b.publicId||''),kind=String(b.kind||'text');const found=await sql`select public_id from public_agents where public_id=${agent} and owner_hash=${own}`;if(!found[0])return json({error:'Agent not found'},404);const count=await sql`select count(*)::int n from public_sources where agent_public_id=${agent}`;if(+count[0].n>=20)return json({error:'Source limit reached (20 per agent)'},429);let content='',url='',title=String(b.title||'').trim().slice(0,120);if(kind==='url'){try{const u=await safeUrl(String(b.url||''));url=u.toString();const r=await fetch(u,{redirect:'manual',headers:{'user-agent':'MicroAI/1.0 source fetcher'}});if(r.status>=300&&r.status<400)throw Error('Redirects are blocked; use the final public URL');if(!r.ok)throw Error(`URL returned ${r.status}`);const len=+(r.headers.get('content-length')||0);if(len>200000)throw Error('URL is larger than 200 KB');content=clean((await r.text()).slice(0,200000)).slice(0,60000);title=title||u.hostname}catch(e){return json({error:(e as Error).message},400)}}else{content=String(b.content||'').trim().slice(0,60000);url=`microai://text/${slug()}`;title=title||'Pasted text'}if(content.length<20)return json({error:'Source must contain at least 20 characters'},400);const source=await sql`insert into public_sources(agent_public_id,kind,title,source_url,content_chars) values(${agent},${kind},${title},${url},${content.length}) returning id`;const sourceSlug=source[0].id,chunks=chunkText(content).slice(0,40);for(let i=0;i<chunks.length;i++){const v=vectorLiteral(localEmbedding(chunks[i]));await sql`insert into knowledge_chunks(agent_public_id,source_slug,source_title,source_url,chunk_index,content,embedding) values(${agent},${sourceSlug},${title},${url},${i},${chunks[i]},${v}::vector)`}return json({source:{id:sourceSlug,kind,title,url,chunks:chunks.length,contentChars:content.length}},201)}
