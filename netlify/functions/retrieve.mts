import {allowed,json,retrieve} from "./_shared.mts";
export default async(req:Request)=>{if(req.method!=="POST")return json({error:"Method not allowed"},405);if(!allowed(req))return json({error:"Origin not allowed"},403);const {question}=await req.json().catch(()=>({}));if(typeof question!=="string"||question.trim().length<2||question.length>600)return json({error:"Question must be 2-600 characters"},400);const rows=await retrieve(question);return json({results:rows.map((r:any,i:number)=>({citation:i+1,title:r.source_title,url:r.source_url,excerpt:r.content,score:Number(r.score)}))});}
