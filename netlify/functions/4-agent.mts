import {db,json,owner,encrypt} from './_shared.mts';
export default async(req:Request)=>{const own=owner(req);if(!own)return json({error:'Valid anonymous session required'},401);const sql=db(),b=await req.json().catch(()=>({})),id=String(b.publicId||'');if(req.method==='GET'){const a=await sql`select public_id,name,instructions,tone,chat_model,(encrypted_groq_key is not null) byok from public_agents where public_id=${new URL(req.url).searchParams.get('publicId')||''} and owner_hash=${own}`;if(!a[0])return json({error:'Agent not found'},404);const sources=await sql`select id,kind,title,source_url,content_chars,created_at from public_sources where agent_public_id=${a[0].public_id} order by created_at desc`;return json({agent:a[0],sources})}if(req.method!=='PATCH')return json({error:'Method not allowed'},405);const key=String(b.groqKey||'').trim();const rows=await sql`update public_agents set name=coalesce(${b.name||null},name),instructions=coalesce(${b.instructions||null},instructions),tone=coalesce(${b.tone||null},tone),chat_model=coalesce(${b.model||null},chat_model),encrypted_groq_key=case when ${key===''?null:key}::text is null then encrypted_groq_key else ${key?encrypt(key):null} end,updated_at=now() where public_id=${id} and owner_hash=${own} returning public_id,name,instructions,tone,chat_model,(encrypted_groq_key is not null) byok`;return rows[0]?json({agent:rows[0]}):json({error:'Agent not found'},404)}
