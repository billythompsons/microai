import {createHash,randomBytes} from 'node:crypto';import {db,json,owner,signSession} from './_shared.mts';
const hash=(s:string)=>createHash('sha256').update(s).digest('hex');
export default async(req:Request)=>{if(req.method!=='POST')return json({error:'Method not allowed'},405);const b=await req.json().catch(()=>({})),action=String(b.action||''),email=String(b.email||'').trim().toLowerCase();if(!/^\S+@\S+\.\S+$/.test(email)||email.length>160)return json({error:'Valid email required'},400);const sql=db();if(action==='signup'){const current=owner(req);if(!current)return json({error:'Anonymous session required'},401);const code=randomBytes(12).toString('base64url'),accountOwner=hash(`account:${email}:${randomBytes(16).toString('hex')}`).slice(0,32);try{await sql`insert into public_accounts(email,owner_hash,recovery_hash) values(${email},${accountOwner},${hash(code)})`;await sql`update public_agents set owner_hash=${accountOwner} where owner_hash=${current}`;return json({session:signSession(`acct_${accountOwner}`),email,recoveryCode:code,message:'Save this recovery code. It is shown once and lets you use your agents on another device.'},201)}catch{return json({error:'An account already exists for this email'},409)}}if(action==='login'){const code=String(b.recoveryCode||'');const rows=await sql`select owner_hash,recovery_hash from public_accounts where email=${email}`;if(!rows[0]||rows[0].recovery_hash!==hash(code))return json({error:'Email or recovery code is incorrect'},401);return json({session:signSession(`acct_${rows[0].owner_hash}`),email})}return json({error:'Action must be signup or login'},400)}
