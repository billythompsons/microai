import {createHash,randomBytes,scryptSync,timingSafeEqual} from 'node:crypto';import {db,json,owner,signSession} from './_shared.mts';
const hash=(s:string)=>createHash('sha256').update(s).digest('hex'),passwordHash=(password:string,salt:string)=>scryptSync(password,salt,32).toString('hex');
const cookie=(session:string)=>`aichatroom_session=${session}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=31536000`;
export default async(req:Request)=>{if(req.method!=='POST')return json({error:'Method not allowed'},405);const b=await req.json().catch(()=>({})),action=String(b.action||''),email=String(b.email||'').trim().toLowerCase(),password=String(b.password||'');if(!/^\S+@\S+\.\S+$/.test(email)||email.length>160)return json({error:'Valid email required'},400);const sql=db();if(action==='signup'){const current=owner(req);if(!current)return json({error:'Anonymous session required'},401);if(password.length<10||password.length>200)return json({error:'Password must be at least 10 characters'},400);const code=randomBytes(16).toString('base64url'),salt=randomBytes(16).toString('hex'),accountOwner=hash(`account:${email}:${randomBytes(16).toString('hex')}`).slice(0,32),session=signSession(`acct_${accountOwner}`);try{await sql`insert into public_accounts(email,owner_hash,recovery_hash,password_salt,password_hash) values(${email},${accountOwner},${hash(code)},${salt},${passwordHash(password,salt)})`;await sql`update public_agents set owner_hash=${accountOwner} where owner_hash=${current}`;return json({session,email,recoveryCode:code,message:'Account created. Save the one-time recovery code in a safe place.'},201,{'set-cookie':cookie(session)})}catch{return json({error:'An account already exists for this email'},409)}}if(action==='login'){const rows=await sql`select owner_hash,password_salt,password_hash from public_accounts where email=${email}`;const actual=rows[0]?.password_hash||'',candidate=rows[0]?.password_salt?passwordHash(password,rows[0].password_salt):'';let valid=false;try{valid=!!actual&&timingSafeEqual(Buffer.from(actual),Buffer.from(candidate))}catch{}if(!valid)return json({error:'Email or password is incorrect'},401);const session=signSession(`acct_${rows[0].owner_hash}`);return json({session,email},200,{'set-cookie':cookie(session)})}if(action==='recover'){const code=String(b.recoveryCode||'');if(password.length<10||password.length>200)return json({error:'New password must be at least 10 characters'},400);const rows=await sql`select owner_hash,recovery_hash from public_accounts where email=${email}`;if(!rows[0]||rows[0].recovery_hash!==hash(code))return json({error:'Email or recovery code is incorrect'},401);const salt=randomBytes(16).toString('hex'),newCode=randomBytes(16).toString('base64url'),session=signSession(`acct_${rows[0].owner_hash}`);await sql`update public_accounts set password_salt=${salt},password_hash=${passwordHash(password,salt)},recovery_hash=${hash(newCode)} where email=${email}`;return json({session,email,recoveryCode:newCode,message:'Password reset. Replace your old recovery code with this new one.'},200,{'set-cookie':cookie(session)})}return json({error:'Action must be signup, login, or recover'},400)}
