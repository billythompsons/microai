import {db,json,AGENT} from "./_shared.mts";import {chunkText,localEmbedding,vectorLiteral} from "../../packages/core/src/embedding.ts";
const BATCH=4;
export default async(req:Request)=>{if(req.method!=="POST")return json({error:"Method not allowed"},405);if(!process.env.INGEST_SECRET||req.headers.get("authorization")!==`Bearer ${process.env.INGEST_SECRET}`)return json({error:"Unauthorized"},401);const sql=db();const body=await req.json().catch(()=>({}));if(body.jobId){const jobs=await sql`select * from ingest_jobs where id=${body.jobId} limit 1`;if(!jobs[0])return json({error:"Job not found"},404);const job:any=jobs[0],chunks=chunkText(job.content),end=Math.min(chunks.length,job.cursor+BATCH);await sql`update ingest_jobs set status='processing',updated_at=now() where id=${job.id}`;for(let i=job.cursor;i<end;i++){const v=vectorLiteral(localEmbedding(chunks[i]));await sql`insert into knowledge_chunks(agent_public_id,source_slug,source_title,source_url,chunk_index,content,embedding) values(${job.agent_public_id},${job.source_slug},${job.source_title},${job.source_url},${i},${chunks[i]},${v}::vector) on conflict(agent_public_id,source_slug,chunk_index) do update set content=excluded.content,embedding=excluded.embedding`;};const done=end>=chunks.length;await sql`update ingest_jobs set cursor=${end},status=${done?'ready':'processing'},updated_at=now() where id=${job.id}`;return json({jobId:job.id,processed:end-job.cursor,cursor:end,total:chunks.length,done,next:done?null:"POST the same jobId again"});}
 const {slug,title,url,content,agentPublicId=AGENT}=body;if(!slug||!title||!url||typeof content!=="string"||content.length>100000)return json({error:"slug, title, url and content (max 100k) are required"},400);const rows=await sql`insert into ingest_jobs(agent_public_id,source_slug,source_title,source_url,content) values(${agentPublicId},${slug},${title},${url},${content}) returning id`;return json({jobId:rows[0].id,status:"pending",next:"POST {jobId} to process the first bounded batch"},202);
};
