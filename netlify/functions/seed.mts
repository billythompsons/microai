import {db,json,AGENT} from "./_shared.mts";import {DEMO_DOCS} from "../../packages/core/src/demo-docs.ts";import {chunkText,localEmbedding,vectorLiteral} from "../../packages/core/src/embedding.ts";
export default async(req:Request)=>{if(req.method!=="POST")return json({error:"Method not allowed"},405);if(!process.env.INGEST_SECRET||req.headers.get("authorization")!==`Bearer ${process.env.INGEST_SECRET}`)return json({error:"Unauthorized"},401);const sql=db();let count=0;for(const doc of DEMO_DOCS){const chunks=chunkText(doc.content);for(let i=0;i<chunks.length;i++){const vector=vectorLiteral(localEmbedding(chunks[i]));await sql`insert into knowledge_chunks(agent_public_id,source_slug,source_title,source_url,chunk_index,content,embedding) values(${AGENT},${doc.slug},${doc.title},${doc.url},${i},${chunks[i]},${vector}::vector) on conflict(agent_public_id,source_slug,chunk_index) do update set content=excluded.content,embedding=excluded.embedding,source_title=excluded.source_title,source_url=excluded.source_url`;count++;}}return json({ok:true,chunks:count});}
