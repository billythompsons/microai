import {db,json,owner,slug,encrypt} from './_shared.mts';
export default async(req:Request)=>{const own=owner(req);if(!own)return json({error:'Valid anonymous session required'},401);const sql=db();if(req.method==='GET'){const rows=await sql`select public_id,name,instructions,tone,chat_model,(encrypted_groq_key is not null) byok,created_at,updated_at from public_agents where owner_hash=${own} order by updated_at desc limit 20`;return json({agents:rows})}if(req.method!=='POST')return json({error:'Method not allowed'},405);const b=await req.json().catch(()=>({}));const name=String(b.name||'').trim().slice(0,60),instructions=String(b.instructions||'Answer clearly and only from the supplied evidence.').trim().slice(0,1200),tone=String(b.tone||'helpful').slice(0,30),model=String(b.model||'openai/gpt-oss-20b').slice(0,80),groqKey=String(b.groqKey||'').trim();if(name.length<2)return json({error:'Agent name is required'},400);if(groqKey&&!groqKey.startsWith('gsk_'))return json({error:'That does not look like a Groq key'},400);const id=`agent-${slug()}`;const rows=await sql`insert into public_agents(public_id,owner_hash,name,instructions,tone,chat_model,encrypted_groq_key) values(${id},${own},${name},${instructions},${tone},${model},${groqKey?encrypt(groqKey):null}) returning public_id,name,instructions,tone,chat_model,(encrypted_groq_key is not null) byok`;return json({agent:rows[0]},201)}
